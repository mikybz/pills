generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id
  email          String     @unique
  name           String?
  locale         String     @default("en")
  theme          String     @default("system")
  countUncertain Boolean    @default(true)
  remindersOn    Boolean    @default(true)
  remindLeadMin  Int        @default(10)
  nagEveryMin    Int        @default(15)
  nagMaxMin      Int        @default(120)
  onboarded      Boolean    @default(false)
  defaultPersonId String?
  defaultPerson   Person?    @relation("DefaultPerson", fields: [defaultPersonId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  doses          DoseLog[]
  selfPerson     Person?    @relation("SelfPerson")
  createdPersons Person[]   @relation("CreatedPersons")
  access         PersonAccess[]
  shareTokens    ShareToken[] @relation("TokenCreator")
  pushSubscriptions PushSubscription[]
  reminderLogs   ReminderLog[]
}

model Person {
  id           String         @id @default(cuid())
  name         String
  kind         String         @default("person")
  timezone     String         @default("Europe/Oslo")
  /// Day window ("HH:MM" wall clock in `timezone`); may wrap midnight.
  wakeTime     String         @default("07:00")
  bedTime      String         @default("23:00")
  selfOfUserId String?        @unique
  selfOf       User?          @relation("SelfPerson", fields: [selfOfUserId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("CreatedPersons", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  access       PersonAccess[]
  medicines    Medicine[]
  shareTokens  ShareToken[]
  defaultFor   User[]         @relation("DefaultPerson")
}

model PersonAccess {
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Boolean  @default(false)
  /// Push to this user when someone else logs a dose for this person.
  notifyLogs Boolean @default(false)
  createdAt DateTime @default(now())

  @@id([personId, userId])
  @@index([userId])
}

model ShareToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("TokenCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())
}

model Medicine {
  id             String    @id @default(cuid())
  personId       String
  person         Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  name           String
  form           String    @default("pill")
  unit           String    @default("mg")
  color          String    @default("blue")
  presets        String    @default("[1]")
  defaultPreset  Float?
  maxPerIntake   Float?
  maxPerDay      Float?
  minIntervalMin Int?
  mode           String?
  doseAmount     Float?
  times          String?
  intervalH      Float?
  startsOn       String?
  endsOn         String?
  remindersEnabled Boolean @default(true)
  /// Ignore the person's day window (night doses allowed, drift not capped at bedtime).
  aroundTheClock Boolean   @default(false)
  /// Late-dose drift: a late dose moves the next fixed slot (rounded, capped at bedtime).
  driftEnabled   Boolean   @default(true)
  scheduleReviewedAt DateTime?
  scheduleChangedAt  DateTime?
  notes          String?
  sortOrder      Int       @default(0)
  hidden         Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  doses          DoseLog[]
  scheduleVersions ScheduleVersion[]
  reminderLogs   ReminderLog[]

  @@index([personId, archivedAt])
}

model DoseLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  amount     Float
  takenAt    DateTime
  slotAt     DateTime?
  status     String   @default("taken")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, takenAt])
  @@index([medicineId, takenAt])
  @@index([medicineId, slotAt])
}

/// A schedule that was in force until `validTo`; kept so history derives past
/// missed slots from the schedule of that time.
model ScheduleVersion {
  id             String   @id @default(cuid())
  medicineId     String
  medicine       Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  mode           String
  doseAmount     Float?
  times          String?
  intervalH      Float?
  startsOn       String?
  endsOn         String?
  minIntervalMin Int?
  timezone       String
  validFrom      DateTime
  validTo        DateTime
  createdAt      DateTime @default(now())

  @@index([medicineId, validTo])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per reminder sent (or snooze pressed). The unique key makes sending
/// idempotent across restarts. Pruned after 7 days.
model ReminderLog {
  id         String    @id @default(cuid())
  medicineId String
  medicine   Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  slotAt     DateTime
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  seq        Int       @default(0)
  until      DateTime?
  sentAt     DateTime  @default(now())

  @@unique([medicineId, slotAt, userId, kind, seq])
  @@index([sentAt])
}
