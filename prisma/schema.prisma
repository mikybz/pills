generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id
  email          String     @unique
  name           String?
  locale         String     @default("en")
  theme          String     @default("system")
  strictness     Float      @default(0.15)
  wakeWindowH    Float      @default(12)
  countUncertain Boolean    @default(true)
  onboarded      Boolean    @default(false)
  defaultPersonId String?
  defaultPerson   Person?    @relation("DefaultPerson", fields: [defaultPersonId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  doses          DoseLog[]
  selfPerson     Person?    @relation("SelfPerson")
  createdPersons Person[]   @relation("CreatedPersons")
  access         PersonAccess[]
  shareTokens    ShareToken[] @relation("TokenCreator")
}

model Person {
  id           String         @id @default(cuid())
  name         String
  kind         String         @default("person")
  selfOfUserId String?        @unique
  selfOf       User?          @relation("SelfPerson", fields: [selfOfUserId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("CreatedPersons", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  access       PersonAccess[]
  medicines    Medicine[]
  shareTokens  ShareToken[]
  defaultFor   User[]         @relation("DefaultPerson")
}

model PersonAccess {
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([personId, userId])
  @@index([userId])
}

model ShareToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("TokenCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())
}

model Medicine {
  id             String    @id @default(cuid())
  personId       String
  person         Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  name           String
  form           String    @default("pill")
  unit           String    @default("mg")
  color          String    @default("blue")
  presets        String    @default("[1]")
  defaultPreset  Float?
  maxPerIntake   Float?
  maxPerDay      Float?
  minIntervalMin Int?
  scheduleHints  String?
  notes          String?
  sortOrder      Int       @default(0)
  hidden         Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  doses          DoseLog[]

  @@index([personId, archivedAt])
}

model DoseLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  amount     Float
  takenAt    DateTime
  status     String   @default("taken")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, takenAt])
  @@index([medicineId, takenAt])
}
